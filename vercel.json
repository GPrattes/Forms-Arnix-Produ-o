{
  "version": 2,
  "name": "arnix-market-research",
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/dashboard.html", "destination": "/dashboard.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/sobre.html", "destination": "/sobre.html" },
    { "source": "/fundador", "destination": "/fundador.html" },
    { "source": "/fundador.html", "destination": "/fundador.html" },
    { "source": "/gabriel-prattes", "destination": "/fundador.html" },
    { "source": "/pesquisa", "destination": "/index.html" },
    { "source": "/favicon.ico", "destination": "/img/arnix-sgv.png" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

