# ── Segredos & Variáveis de Ambiente ─────────────────────────
.env
.env.*
*.local
*.env.production

# ── Banco de Dados Local SQLite ──────────────────────────────
*.db
*.sqlite
*.sqlite3
data/*.db
data/respostas.db

# ── Python Cache & Venv ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# ── Vercel & Node ────────────────────────────────────────────
.vercel/
node_modules/
npm-debug.log*

# ── Sistema Operacional & IDE ────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
